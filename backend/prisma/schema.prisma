generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  username                 String  @unique
  email                    String  @unique
  password                 String?
  isAdmin                  Boolean @default(false)
  ldapDN                   String? @unique
  shareSizeLimit           String?
  storageQuotaLimit        String?
  canCreatePermanentShares Boolean @default(false)

  shares                Share[]
  refreshTokens         RefreshToken[]
  loginTokens           LoginToken[]
  reverseShares         ReverseShare[]
  shareUserRecipients   ShareUserRecipient[]
  adminNoticeDismissals AdminNoticeDismissal[]

  totpEnabled        Boolean             @default(false)
  totpVerified       Boolean             @default(false)
  totpSecret         String?
  resetPasswordToken ResetPasswordToken?

  isActivated              Boolean   @default(true)
  activationToken          String?   @unique
  activationTokenExpiresAt DateTime?
  activationAttempts       Int       @default(0)

  // Granular per-user opt-out for JobsService's sender-side expiry
  // reminder — only meaningful for a registered creator, who's the only
  // one with an account/settings to control it from. An anonymous
  // sender's own reminder (keyed off Share.senderEmail instead) has no
  // such toggle to check, same reasoning as the unconditional
  // "here's your link" backstop email.
  notifyOnExpiringSentShares Boolean @default(true)

  oAuthUsers OAuthUser[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique @default(uuid())
  createdAt DateTime @default(now())

  expiresAt DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  oauthIDToken String? // prefixed with the ID of the issuing OAuth provider, separated by a colon
}

model LoginToken {
  token     String   @id @default(uuid())
  createdAt DateTime @default(now())

  expiresAt DateTime

  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  used   Boolean @default(false)
}

model ResetPasswordToken {
  token     String   @id @default(uuid())
  createdAt DateTime @default(now())

  expiresAt DateTime

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OAuthUser {
  id               String @id @default(uuid())
  provider         String
  providerUserId   String
  providerUsername String
  userId           String
  user             User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Share {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  name          String?
  uploadLocked  Boolean  @default(false)
  isZipReady    Boolean  @default(false)
  views         Int      @default(0)
  expiration    DateTime
  description   String?
  removedReason String?

  creatorId String?
  creator   User?   @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  // Self-reported at creation time by an anonymous (not signed-in) sender —
  // never set for a signed-in creator, whose identity is already the
  // `creator` relation above. Lets us always email an anonymous sender their
  // own link/download notification, regardless of whether OTP verification
  // (share.requireEmailVerificationForAnonymousShares) is even enabled.
  senderEmail String?

  // Set once JobsService.notifyExpiringSenders() has emailed this share's
  // owner that it's about to expire — the dedup guard against re-sending
  // every time that job's cron tick runs.
  expiryReminderSentAt DateTime?

  // True if at least one of this share's files was imported from the NAS
  // (NasImportService) rather than uploaded — a symlink into
  // SHARE_DIRECTORY, not a real copy. Gates two things: complete() skips
  // zip generation entirely for these shares (creating archive.zip would
  // duplicate the imported content onto disk, the exact thing this
  // feature exists to avoid), and getUserActiveStorageUsage() excludes
  // them from quota accounting (a symlink consumes ~0 real disk).
  hasNasImportedFiles Boolean @default(false)

  reverseShareId String?
  reverseShare   ReverseShare? @relation(fields: [reverseShareId], references: [id], onDelete: Cascade)

  security        ShareSecurity?
  recipients      ShareRecipient[]
  userRecipients  ShareUserRecipient[]
  files           File[]
  storageProvider String               @default("LOCAL")
}

model ReverseShare {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  token                 String   @unique @default(uuid())
  shareExpiration       DateTime
  maxShareSize          String
  sendEmailNotification Boolean
  remainingUses         Int
  simplified            Boolean  @default(false)
  publicAccess          Boolean  @default(true)

  creatorId String
  creator   User   @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  shares Share[]
}

model ShareRecipient {
  id    String @id @default(uuid())
  email String

  // Set the first time this specific recipient downloads anything from
  // the share — FileService.notifyDownload's recipientId branch sets it
  // unconditionally (not gated behind the download-notification email
  // toggle), since JobsService.notifyExpiringRecipients() needs to know
  // "did they ever pick this up" independently of whether that other
  // feature is even enabled.
  downloadedAt DateTime?
  // Same dedup role as Share.expiryReminderSentAt above, scoped to this
  // one recipient rather than the whole share — each named recipient on
  // an Email-mode share gets their own reminder and their own guard.
  expiryReminderSentAt DateTime?

  shareId String
  share   Share  @relation(fields: [shareId], references: [id], onDelete: Cascade)
}

model File {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  name String
  size String

  shareId String
  share   Share  @relation(fields: [shareId], references: [id], onDelete: Cascade)
}

model ShareSecurity {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  password             String?
  maxViews             Int?
  restrictToRecipients Boolean @default(false)

  shareId String? @unique
  share   Share?  @relation(fields: [shareId], references: [id], onDelete: Cascade)
}

model ShareUserRecipient {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  shareId String
  share   Share  @relation(fields: [shareId], references: [id], onDelete: Cascade)

  @@unique([userId, shareId])
}

model Config {
  updatedAt DateTime @updatedAt

  name         String
  category     String
  type         String
  defaultValue String  @default("")
  value        String?
  obscured     Boolean @default(false)
  secret       Boolean @default(true)
  locked       Boolean @default(false)
  order        Int

  @@id([name, category])
}

model AdminNoticeDismissal {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  noticeId            String  @unique
  dismissedByUserId   String?
  dismissedByUsername String?
  dismissedByUser     User?   @relation(fields: [dismissedByUserId], references: [id], onDelete: SetNull)
}

model AnonymousShareVerification {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)

  @@index([email])
}

// One row per share ClamAV actually attempted to scan (i.e. clamav.enabled
// was on and clamd was reachable) — the admin's "analyses" history. A share
// can be deleted or expire long after it was scanned, so shareId/shareName
// are plain denormalized fields rather than a relation: the log survives
// the share.
model ClamavScan {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  shareId           String?
  shareName         String?
  status            String // "clean" | "infected" | "error"
  fileCount         Int     @default(0)
  infectedCount     Int     @default(0)
  infectedFileNames String?
  errorMessage      String?

  @@index([createdAt])
}
