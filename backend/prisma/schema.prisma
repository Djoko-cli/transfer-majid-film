generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  username                 String  @unique
  email                    String  @unique
  password                 String?
  isAdmin                  Boolean @default(false)
  ldapDN                   String? @unique
  shareSizeLimit           String?
  storageQuotaLimit        String?
  canCreatePermanentShares Boolean @default(false)

  // Non-nulle veut dire « ce compte a une photo » ; le chemin du fichier s'en
  // déduit (AVATAR_DIRECTORY/<id>.webp), il n'a pas à être stocké. L'horodatage
  // sert aussi de cache-buster : la navbar demande l'image avec `?v=<ms>`, donc
  // changer de photo change l'URL et contourne un cache posé à un an.
  avatarUpdatedAt DateTime?

  shares                Share[]
  refreshTokens         RefreshToken[]
  loginTokens           LoginToken[]
  reverseShares         ReverseShare[]
  shareUserRecipients   ShareUserRecipient[]
  adminNoticeDismissals AdminNoticeDismissal[]
  trustedDevices        TrustedDevice[]
  contributions         ShareContribution[]

  totpEnabled        Boolean             @default(false)
  totpVerified       Boolean             @default(false)
  totpSecret         String?
  resetPasswordToken ResetPasswordToken?

  isActivated              Boolean   @default(true)
  activationToken          String?   @unique
  activationTokenExpiresAt DateTime?
  activationAttempts       Int       @default(0)

  // A self-service email change is held here until the new address proves
  // it exists and is reachable. The account keeps its current email the
  // whole time, so a typo costs nothing: the code never arrives and the
  // row never changes. Applying first and de-activating after would be
  // simpler and would lock the owner out of their own account on exactly
  // that typo — the failure this is here to prevent.
  //
  // Not used by the admin path (UserService.update from the console),
  // which is a deliberate administrative act on someone else's row.
  pendingEmail               String?
  pendingEmailToken          String?   @unique
  pendingEmailTokenExpiresAt DateTime?
  // When the code was last put in the post. Stored rather than tracked in
  // the browser so the resend cooldown survives a reload — which is exactly
  // what someone does when the mail has not arrived, the one situation this
  // whole resend path exists for.
  pendingEmailLastSentAt     DateTime?

  // Granular per-user opt-out for JobsService's sender-side expiry
  // reminder — only meaningful for a registered creator, who's the only
  // one with an account/settings to control it from. An anonymous
  // sender's own reminder (keyed off Share.senderEmail instead) has no
  // such toggle to check, same reasoning as the unconditional
  // "here's your link" backstop email.
  notifyOnExpiringSentShares Boolean @default(true)

  // Sibling of the above, for the receipt sent the moment a share is
  // finished rather than when it is about to expire. Same reasoning for
  // living on the user rather than in admin config: it is a personal
  // mailbox preference, and only a registered creator has somewhere to
  // set it. Defaults on because the receipt is the only durable record of
  // who a transfer went to — "Mes partages" lists the share, not the send.
  // An anonymous sender's equivalent stays unconditional: with no account
  // there is no toggle, and no "Mes partages" to fall back on.
  notifyOnSentShares Boolean @default(true)

  oAuthUsers OAuthUser[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique @default(uuid())
  createdAt DateTime @default(now())

  expiresAt DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  oauthIDToken String? // prefixed with the ID of the issuing OAuth provider, separated by a colon
}

model LoginToken {
  token     String   @id @default(uuid())
  createdAt DateTime @default(now())

  expiresAt DateTime

  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  used   Boolean @default(false)
}

model ResetPasswordToken {
  token     String   @id @default(uuid())
  createdAt DateTime @default(now())

  expiresAt DateTime

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Same id/token split as RefreshToken above, for the same reason: `id`
// is what a list/revoke endpoint can safely return to a client (self-
// service or admin) - `token` is the actual bearer secret held only in
// the httpOnly trusted_device cookie, and must never appear in any API
// response, including to an admin, since anyone who read it back could
// paste it into their own cookie jar and skip both password and TOTP as
// that user for however long it has left to live. ipAddress/userAgent
// are display-only, captured once at creation from the same request
// headers this app already logs a share download's device from
// (FileService.notifyDownload) - never re-verified against later use,
// so purely informational for a human deciding whether to revoke.
model TrustedDevice {
  id        String   @id @default(uuid())
  token     String   @unique @default(uuid())
  createdAt DateTime @default(now())
  expiresAt DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  ipAddress String?
  userAgent String?
}

model OAuthUser {
  id               String @id @default(uuid())
  provider         String
  providerUserId   String
  providerUsername String
  userId           String
  user             User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Share {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  name          String?
  uploadLocked  Boolean  @default(false)
  isZipReady    Boolean  @default(false)
  views         Int      @default(0)
  expiration    DateTime
  description   String?
  removedReason String?

  creatorId String?
  creator   User?   @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  // Self-reported at creation time by an anonymous (not signed-in) sender —
  // never set for a signed-in creator, whose identity is already the
  // `creator` relation above. Lets us always email an anonymous sender their
  // own link/download notification, regardless of whether OTP verification
  // (share.requireEmailVerificationForAnonymousShares) is even enabled.
  senderEmail String?

  // Set once JobsService.notifyExpiringSenders() has emailed this share's
  // owner that it's about to expire — the dedup guard against re-sending
  // every time that job's cron tick runs.
  expiryReminderSentAt DateTime?

  // True if at least one of this share's files was imported from the NAS
  // (NasImportService) rather than uploaded — a symlink into
  // SHARE_DIRECTORY, not a real copy. Gates two things: complete() skips
  // zip generation entirely for these shares (creating archive.zip would
  // duplicate the imported content onto disk, the exact thing this
  // feature exists to avoid), and getUserActiveStorageUsage() excludes
  // them from quota accounting (a symlink consumes ~0 real disk).
  hasNasImportedFiles Boolean @default(false)

  reverseShareId String?
  reverseShare   ReverseShare? @relation(fields: [reverseShareId], references: [id], onDelete: Cascade)

  // A collection transfer: the single container behind a deposit link. It
  // stays uploadLocked for its whole life, because that is what makes it
  // readable — and it accepts files anyway, which no other locked transfer
  // does. The exception is carried by this column rather than inferred from
  // the presence of a link, so that it is greppable and a future reader of
  // local.service.ts's lock check knows exactly what to look for.
  isCollection Boolean @default(false)

  collectionOf  ReverseShare?       @relation("ReverseShareContainer")
  contributions ShareContribution[]

  security        ShareSecurity?
  recipients      ShareRecipient[]
  userRecipients  ShareUserRecipient[]
  files           File[]
  downloads       ShareDownload[]
  storageProvider String               @default("LOCAL")
}

model ReverseShare {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  token                 String  @unique @default(uuid())
  maxShareSize          String
  sendEmailNotification Boolean
  remainingUses         Int
  publicAccess          Boolean @default(true)

  // Created with the link and never later, and it takes the link's token
  // for its id — so there is exactly one public address and the owner
  // writes it. A link nobody ever uses leaves an empty transfer in their
  // list: that is intended, the empty transfer is the collection, waiting.
  containerShareId String @unique
  containerShare   Share  @relation("ReverseShareContainer", fields: [containerShareId], references: [id], onDelete: Cascade)

  // When depositing stops. Replaces shareExpiration, which used to close
  // the link and delete the files with a single date.
  collectionEndsAt DateTime

  // How long the transfer outlives the end of collection, in seconds. The
  // container's own expiration is collectionEndsAt + this, computed once,
  // at closing time.
  retentionSeconds Int

  // All three set once, by the reverse share's own creator, at creation
  // time — never by whoever uploads through it (see ShareService.create()'s
  // own override, the same pattern already used for shareExpiration above).
  // Optional, same as a direct share's own name/description/security.
  // password is already hashed at this point (ReverseShareService.create,
  // same argon2 call AuthService uses) — never a plaintext round-trip
  // through any later request.
  name        String?
  description String?
  password    String?
  maxViews    Int?

  creatorId String
  creator   User   @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  // The one-share-per-submission relation for the old upload-via-token
  // path, which predated the container and has been removed: nothing
  // writes Share.reverseShareId any more (ShareService.create()'s own
  // reverseShare branch is gone), so this is permanently empty going
  // forward. Left as a field rather than migrated away, since dropping a
  // column was outside that removal's scope. Not the container itself —
  // that is containerShare above, a distinct one-to-one relation. Renamed
  // off the old `shares` so the two can never be confused.
  perSubmissionShares Share[]
}

model ShareContribution {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // The first name that was typed. Never verified, and deliberately so:
  // among friends, a name one could lie about is enough to know who is
  // still missing.
  name String?

  // The address, and only ever the one the one-time code proved — never
  // the one that was typed. Same rule as ShareService.create() applies to
  // an anonymous sender, and for the same reason: a declared but unproven
  // address would let someone sign a contribution in another person's name.
  email String?

  // Set instead of name/email when the contributor is signed in: their
  // account already carries both, and asking again would be absurd.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Open on creation, closed when the contributor is done. While it is
  // open, it is what authorises writing into the container.
  completedAt DateTime?

  shareId String
  share   Share  @relation(fields: [shareId], references: [id], onDelete: Cascade)

  files File[]

  @@index([shareId, createdAt])
}

model ShareRecipient {
  id    String @id @default(uuid())
  email String

  // Set the first time this specific recipient downloads anything from
  // the share — FileService.notifyDownload's recipientId branch sets it
  // unconditionally (not gated behind the download-notification email
  // toggle), since JobsService.notifyExpiringRecipients() needs to know
  // "did they ever pick this up" independently of whether that other
  // feature is even enabled.
  downloadedAt         DateTime?
  // Same dedup role as Share.expiryReminderSentAt above, scoped to this
  // one recipient rather than the whole share — each named recipient on
  // an Email-mode share gets their own reminder and their own guard.
  expiryReminderSentAt DateTime?

  shareId String
  share   Share  @relation(fields: [shareId], references: [id], onDelete: Cascade)
}

model File {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  name String
  size String

  // "pending" | "ready" | "failed" | "unsupported" — set by ThumbnailService.
  // null for every file that predates this column, and for a non-video file
  // ThumbnailService never touches. No stored path: a "ready" thumbnail
  // always lives at the same implicit on-disk spot as the file itself, see
  // SHARE_DIRECTORY/<shareId>/<id>.thumb.jpg in local.service.ts.
  thumbnailStatus String?

  shareId String
  share   Share  @relation(fields: [shareId], references: [id], onDelete: Cascade)

  // Which contribution this file came in with. Null for every file that
  // predates this column and for every ordinary transfer.
  contributionId String?
  contribution   ShareContribution? @relation(fields: [contributionId], references: [id], onDelete: SetNull)
}

model ShareSecurity {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  password             String?
  maxViews             Int?
  restrictToRecipients Boolean @default(false)

  shareId String? @unique
  share   Share?  @relation(fields: [shareId], references: [id], onDelete: Cascade)
}

model ShareUserRecipient {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  shareId String
  share   Share  @relation(fields: [shareId], references: [id], onDelete: Cascade)

  @@unique([userId, shareId])
}

// One row per real download FileService.notifyDownload() is called for -
// a zip of the whole share or a single file, by a named Email-mode
// recipient or an anonymous/Link-mode visitor. Separate from Share.views
// (a page/token-access counter, see ShareService.increaseViewCount) and
// from ShareRecipient.downloadedAt (a single first-download timestamp
// used only by JobsService.notifyExpiringRecipients) - this is the first
// place either signal becomes a real, replayable log instead of a
// counter or a flag.
//
// fileName and recipientEmail are snapshotted plain strings, not
// relations to File/ShareRecipient: a file can be removed from its share
// independently (DELETE shares/:shareId/files/:fileId) without touching
// the share itself, and this audit trail must outlive that removal
// rather than cascade away with it. fileName is null for a whole-share
// zip download. recipientEmail is null for an anonymous/Link-mode
// download, or when a signed-in ShareUserRecipient reaches a file
// without the emailed link's own ?recipient= query param (see
// account/received.tsx) - the same blind spot ShareRecipient.downloadedAt
// already has today, not a new one.
model ShareDownload {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  fileName       String?
  recipientEmail String?
  ipAddress      String?

  shareId String
  share   Share  @relation(fields: [shareId], references: [id], onDelete: Cascade)

  @@index([shareId, createdAt])
}

model Config {
  updatedAt DateTime @updatedAt

  name         String
  category     String
  type         String
  defaultValue String  @default("")
  value        String?
  obscured     Boolean @default(false)
  secret       Boolean @default(true)
  locked       Boolean @default(false)
  order        Int

  @@id([name, category])
}

model AdminNoticeDismissal {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  noticeId            String  @unique
  dismissedByUserId   String?
  dismissedByUsername String?
  dismissedByUser     User?   @relation(fields: [dismissedByUserId], references: [id], onDelete: SetNull)
}

model AnonymousShareVerification {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)

  @@index([email])
}

// One row per share ClamAV actually attempted to scan (i.e. clamav.enabled
// was on and clamd was reachable) — the admin's "analyses" history. A share
// can be deleted or expire long after it was scanned, so shareId/shareName
// are plain denormalized fields rather than a relation: the log survives
// the share.
model ClamavScan {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  shareId           String?
  shareName         String?
  status            String // "clean" | "infected" | "error"
  fileCount         Int     @default(0)
  infectedCount     Int     @default(0)
  infectedFileNames String?
  errorMessage      String?
  // Only set once infectedCount > 0 — "delete" | "quarantine" | "none",
  // matching clamav.infectedFileAction's own values at the time this scan
  // ran (not necessarily what it's set to *now*). null for every
  // clean/error scan, and for an infected scan whose own delete/
  // quarantine attempt itself failed (see checkAndRemove) — "none" is
  // still recorded even though nothing was removed, since it's itself
  // the outcome the admin configured, not a failure to record one.
  action            String?

  @@index([createdAt])
}

// A row's mere existence means this still is excluded from BrandPanel's
// public rotation — absence is the default (enabled), same "existence as
// the fact" idiom AdminNoticeDismissal already uses. Keeps every one of
// the ~106 stills already in frontend/src/data/brandProjects.ts enabled
// with zero backfill, and any still added there later defaults to shown
// with no migration of its own needed.
model DisabledBrandSlide {
  slug       String
  still      Int
  disabledAt DateTime @default(now())

  @@id([slug, still])
}

// The live catalog for BrandPanel's rotation, kept in sync from
// majid.film by BrandSyncService (backend/src/brandSlides/brandSync.
// service.ts) — see MAJIDFILM_SOURCE_ROOT in constants.ts. Frontend's own
// hardcoded frontend/src/data/brandProjects.ts stays untouched as a
// fallback for whenever this is empty (not yet synced, or the NAS mount
// unavailable) — it is NOT backfilled from that file; the first sync just
// discovers everything fresh from the real source. Sync only ever adds or
// updates a row here, never deletes one that's gone missing upstream —
// same "never delete" principle majid.film's own deployer.py already
// documents for the same reason (a folder transiently absent mid-deploy
// shouldn't destroy curation history).
model BrandProject {
  slug      String   @id
  title     String
  year      String
  updatedAt DateTime @updatedAt

  stills BrandStill[]
}

// widths is JSON-encoded (e.g. "[640,1280,2048,3840]") rather than a real
// array column — this schema has no Json field anywhere and SQLite has no
// native array type; every other multi-value case in this app already
// goes through a plain String for the same reason (see e.g. Config's own
// scalar-only fields). Only a width with BOTH a .avif and a .webp
// derivative on majid.film's side is recorded here.
model BrandStill {
  slug   String
  still  Int
  widths String

  project BrandProject @relation(fields: [slug], references: [slug], onDelete: Cascade)

  @@id([slug, still])
}
