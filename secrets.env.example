# Secrets, kept out of config.yaml on purpose.
#
# config.yaml (see config.example.yaml) mirrors the admin panel live in both
# directions — which is exactly why it's the wrong place for a password or
# API key: it's a plain file, meant to be opened and hand-edited, sitting
# right there in the app's data folder. Anything below is never written to
# it and never read back from it, no matter what the admin panel shows.
#
# Copy this file to secrets.env, fill in what you actually use (leave the
# rest blank or unset — an unset variable simply means "no override", the
# field falls back to whatever's in the admin panel), then point your
# container at it and lock it down:
#
#   cp secrets.env.example secrets.env
#   chmod 600 secrets.env
#
# and in docker-compose.yml, uncomment the matching env_file line under the
# backend service. Unlike config.yaml, this file is boot-time only — no live
# watcher — so a change here needs a container restart to take effect. Any
# variable set here also disables that one field in the admin panel (shown
# disabled, with a note) — the environment is authoritative for as long as
# the variable is set; remove it to manage that field from the panel again.

# --- SMTP ---
SMTP_PASSWORD=

# --- LDAP ---
LDAP_BIND_PASSWORD=

# --- S3 ---
S3_KEY=
S3_SECRET=

# --- OAuth client secrets ---
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_DISCORD_CLIENT_SECRET=
OAUTH_OIDC_CLIENT_SECRET=
