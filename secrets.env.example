# Secrets, kept out of config.yaml on purpose.
#
# config.yaml (see config.example.yaml) mirrors the admin panel live in both
# directions — which is exactly why it's the wrong place for a password or
# API key: it's a plain file the app itself writes to on every admin-panel
# change. This file is the opposite on purpose: the app only ever reads it,
# never writes to it — docker-compose.yml mounts it `:ro` so that's true
# even at the filesystem level, not just by convention.
#
# Copy it to secrets.env, fill in what you actually use (leave the rest
# blank or unset — an unset variable simply means "no override", the field
# falls back to whatever's in the admin panel), lock it down, and it just
# works — docker-compose.yml already mounts it:
#
#   cp secrets.env.example secrets.env
#   chmod 600 secrets.env
#
# Like config.yaml, it's watched — edit it by hand and the change is picked
# up live, no container restart needed. Any variable set here also disables
# that one field in the admin panel (shown disabled, with a note) — the
# file is authoritative for as long as the variable is set in it; remove it
# from here to manage that field from the panel again.

# --- SMTP ---
SMTP_PASSWORD=

# --- LDAP ---
LDAP_BIND_PASSWORD=

# --- S3 ---
S3_KEY=
S3_SECRET=

# --- OAuth client secrets ---
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_DISCORD_CLIENT_SECRET=
OAUTH_OIDC_CLIENT_SECRET=
