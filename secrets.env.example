# Secrets, kept in a separate file from config.yaml on purpose.
#
# This mirrors the admin panel live in both directions, exactly like
# config.yaml (see config.example.yaml) does for everything else — set a
# value here and it shows up in the panel; set it in the panel and it's
# written back here. It's a second file rather than just living inside
# config.yaml so it can be permissioned tighter (chmod 600) and handled
# separately from the bulk of the config — e.g. left out of a support
# screenshot or a casual backup of config.yaml alone.
#
# Copy it to secrets.env, fill in what you actually use (leave the rest
# blank or unset — an unset variable simply means "not set yet", same as
# an empty field in the admin panel), lock it down, and it just works —
# docker-compose.yml already mounts it:
#
#   cp secrets.env.example secrets.env
#   chmod 600 secrets.env
#
# A hand-edit is picked up live, no container restart needed — same
# directory-watch mechanism as config.yaml. A value set from the admin
# panel is written back here the same way, and the whole file is
# regenerated (not patched) the first time anything changes after a hand
# edit, so any of your own comments or formatting get replaced by this
# same canonical layout — the same tradeoff config.yaml already makes for
# true two-way sync over a structure-preserving patch.

# --- General ---
# Fine-grained GitHub PAT, read-only, restricted to just this repo's
# Releases permission — lets the admin sidebar show whether the running
# build is the latest release. Leave blank to just not show that badge.
GENERAL_VERSION_CHECK_TOKEN=

# --- Cache (only meaningful if cache.redis-enabled is on) ---
CACHE_REDIS_URL=

# --- SMTP ---
SMTP_PASSWORD=

# --- LDAP ---
LDAP_BIND_PASSWORD=

# --- S3 ---
S3_KEY=
S3_SECRET=

# --- OAuth client secrets ---
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_DISCORD_CLIENT_SECRET=
OAUTH_OIDC_CLIENT_SECRET=
