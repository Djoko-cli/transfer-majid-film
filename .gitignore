# project specific
/backend/data/
/data/

# SQLite databases, wherever they land. The real dev one is already covered
# by /backend/data/ above; this catches the strays, because pointing the
# sqlite3 CLI at a path that does not exist silently CREATES an empty
# database there rather than failing — a typo'd query is enough to leave one
# next to schema.prisma, where `git add -A` would happily commit it. No .db
# or .sqlite file is tracked in this repo, so this masks nothing real.
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
/docs/build/
/docs/.docusaurus
/docs/.cache-loader
/config.yaml

# impeccable skill's own scratch output (design critique reports etc.) -
# tool-generated, timestamped, not meant to be permanent project content.
# Was previously untracked-by-omission rather than by rule, which let a
# handful of report files get committed by accident from two different
# invocation directories (.impeccable/ at repo root, frontend/.impeccable/).
.impeccable/

# Jetbrains specific (webstorm)
.idea/**/**

# IDE specific
.claude
.vscode

# Temp folder for generative work
/temp/**
